{
  "name": "llmux",
  "version": "0.1.0",
  "description": "Unified LLM inference proxy with multi-provider routing, fallbacks, and caching",
  "keywords": [
    "cerebras",
    "groq",
    "inference",
    "llm",
    "openrouter",
    "proxy",
    "sambanova",
    "together"
  ],
  "license": "MIT",
  "author": "",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "_:chk": "bun format && bun lint:fix && bun typecheck",
    "dev": "bun run --watch src/index.ts",
    "build": "bun build --target=node src/index.ts --outdir=dist",
    "build:binary": "bun run scripts/build.ts",
    "start": "bun dist/index.js",
    "lint": "bun oxlint src/ workers/ docs/",
    "lint:fix": "bun oxlint src/ workers/ docs/ --fix",
    "format": "bun oxfmt src/ workers/ docs/ package.json",
    "format:check": "bun oxfmt src/ --check",
    "typecheck": "bun tsc --noEmit",
    "test": "bun test",
    "test:watch": "bun test --watch"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "fastify": "^5.8.5",
    "ioredis": "^5.10.1",
    "lru-cache": "^11.3.5",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "undici": "^8.1.0",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.13",
    "@types/node": "^25.6.0",
    "oxc-transform": "^0.128.0",
    "oxfmt": "^0.47.0",
    "oxlint": "^1.62.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "bun": ">=1.2.0"
  },
  "packageManager": "bun@1.3.13"
}
