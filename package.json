{
  "name": "llmux",
  "version": "0.1.0",
  "description": "Unified LLM inference proxy with multi-provider routing, fallbacks, and caching",
  "keywords": [
    "cerebras",
    "groq",
    "inference",
    "llm",
    "openrouter",
    "proxy",
    "sambanova",
    "together"
  ],
  "license": "MIT",
  "author": "",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "bun build --target=node src/index.ts --outdir=dist",
    "build:binary": "bun run scripts/build.ts",
    "start": "bun dist/index.js",
    "lint": "bun oxlint src/",
    "lint:fix": "bun oxlint src/ --fix",
    "format": "bun oxfmt src/",
    "format:check": "bun oxfmt src/ --check",
    "typecheck": "bun tsc --noEmit",
    "test": "bun test",
    "test:watch": "bun test --watch"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "fastify": "^5.1.0",
    "ioredis": "^5.4.1",
    "lru-cache": "^11.0.2",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "undici": "^7.1.0",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@types/bun": "^1.3.13",
    "@types/node": "^22.10.1",
    "oxc-transform": "^0.41.0",
    "oxfmt": "^0.47.0",
    "oxlint": "^1.62.0",
    "typescript": "^5.7.2"
  },
  "engines": {
    "bun": ">=1.2.0"
  },
  "packageManager": "bun@1.2.0"
}
