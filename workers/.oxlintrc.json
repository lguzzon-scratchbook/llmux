{
  "$schema": "../node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "rules": {
    "no-console": "off",
    "no-debugger": "error",
    "no-unused-vars": "error",
    "no-undef": "error",
    "no-var": "error",
    "prefer-const": "warn"
  },
  "env": {
    "builtin": true,
    "es2022": true,
    "worker": true
  },
  "ignorePatterns": [
    "dist/**/*",
    "node_modules/**/*",
    "**/*.d.ts"
  ]
}
